# Copy to .env and fill blanks. The same loader reads a sealed .env in prod;
# only endpoints/secrets differ between dev and prod.

APP_ENV=development
PORT=8080
WEB_ORIGIN=http://localhost:5173

# --- Database (Postgres 16; Compose locally) ---
DATABASE_URL=postgres://lab:lab@localhost:5432/lab?sslmode=disable

# --- Object storage (MinIO locally, S3 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true
S3_BUCKET_ORIGINALS=artifacts-originals
S3_BUCKET_RENDERED=artifacts-rendered
S3_PUBLIC_URL_BASE=http://localhost:9000

# --- Email (Mailpit locally, SES in prod) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@graphene-lab.org

# --- Registration allowlist (email/password auth) ---
ALLOWED_EMAIL_DOMAINS=nus.edu.sg,u.nus.edu

# --- Auth signing ---
JWT_SIGNING_KEY=dev-insecure-jwt-key-change-me
INVITE_SIGN_KEY=dev-insecure-invite-key-change-me
DIGEST_SIGN_KEY=dev-insecure-digest-key-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- Sidecars ---
NBCONVERT_URL=http://localhost:8090
SEARXNG_URL=http://localhost:8888

# --- AI (Ollama-native; any OpenAI-compatible endpoint works) ---
# The active provider/model is selected in aiconf.local.json; the values
# below are fallbacks and tuning knobs.
OLLAMA_BASE_URL=http://localhost:11434
AI_CHAT_MODEL=qwen2.5:7b-instruct
AI_WORKFLOW_MODEL=qwen2.5:7b-instruct
# Optional timeouts in seconds (raise for slow local models)
AI_OUTBOUND_TIMEOUT_SECONDS=30
AI_WORKFLOW_TIMEOUT_SECONDS=150
# Brave Web Search API key — powers the agent's web_search tool (free tier at
# https://brave.com/search/api/). Leave blank to disable web search.
BRAVE_SEARCH_API_KEY=

# --- Daily digest scheduling ---
DIGEST_HOUR=7
LAB_TIMEZONE=Asia/Singapore
